{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.16/MicrosoftTeams.schema.json",
  "manifestVersion": "1.16",
  "version": "0.1.0",
  "id": "[TEAMS_APP_ID]",
  "packageName": "ar.com.sdu.seshat.agent.dev",
  "developer": {
    "name": "SDU-CN Governed DEV",
    "websiteUrl": "https://example.invalid/sdu-dev",
    "privacyUrl": "https://example.invalid/sdu-dev/privacy",
    "termsOfUseUrl": "https://example.invalid/sdu-dev/terms"
  },
  "name": {
    "short": "Seshat SDU Agent",
    "full": "Seshat SDU Agent DEV"
  },
  "description": {
    "short": "Governed DEV chat entrypoint for the SDU agent chain.",
    "full": "Governed DEV chat entrypoint for the SDU agent chain. Template only; no tenant install or live message execution."
  },
  "accentColor": "#2F6FED",
  "bots": [
    {
      "botId": "[BOT_ID]",
      "scopes": [
        "personal",
        "team"
      ],
      "supportsFiles": false,
      "isNotificationOnly": false
    }
  ],
  "validDomains": [
    "localhost",
    "[DEV_TUNNEL_OR_HOST]"
  ],
  "webApplicationInfo": {
    "id": "[ENTRA_APP_ID]",
    "resource": "api://[DEV_TUNNEL_OR_HOST]/[ENTRA_APP_ID]"
  }
}
