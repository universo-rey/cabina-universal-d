    "python-envs.defaultEnvManager": "ms-python.python:system",
    "agileagentcanvas.outputFolder": ".agileagentcanvas-context",
    "agileagentcanvas.userCataloguePath": ".agents/skills",
    "agileagentcanvas.autoSync": false,
    "agileagentcanvas.graphify.autoBootstrapOnNewProject": false,
