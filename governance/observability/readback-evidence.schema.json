{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SDU Readback Evidence",
  "type": "object",
  "required": [
    "readback_id",
    "status",
    "validators",
    "live_executed",
    "rollback",
    "next_gate"
  ],
  "properties": {
    "readback_id": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "validators": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "live_executed": {
      "const": false
    },
    "rollback": {
      "type": "string"
    },
    "next_gate": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
