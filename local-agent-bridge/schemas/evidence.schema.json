{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SDU Local Bridge Evidence",
  "type": "object",
  "required": [
    "evidence_id",
    "route_id",
    "assigned_agent",
    "gate_agent",
    "live_executed",
    "sanitized",
    "blocked_surfaces"
  ],
  "properties": {
    "evidence_id": {
      "type": "string"
    },
    "route_id": {
      "type": "string"
    },
    "assigned_agent": {
      "type": "string"
    },
    "gate_agent": {
      "type": "string"
    },
    "live_executed": {
      "const": false
    },
    "sanitized": {
      "const": true
    },
    "blocked_surfaces": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
