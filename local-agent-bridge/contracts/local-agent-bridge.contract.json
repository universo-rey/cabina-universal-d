{
  "contractId": "sdu.local.agent.bridge.dev",
  "version": "2026-06-03",
  "transport": "http-loopback",
  "allowedRoutes": [
    "GET /",
    "GET /health",
    "GET /api/dashboard",
    "GET /api/shell/status",
    "POST /v1/shell/command",
    "POST /v1/sdu/route"
  ],
  "request": {
    "required": [
      "channel",
      "synthetic",
      "text",
      "requestedBy"
    ],
    "syntheticRequired": true,
    "textMaxChars": 1200
  },
  "response": {
    "required": [
      "status",
      "route_id",
      "assigned_agent",
      "live_executed",
      "evidence"
    ],
    "liveExecutedValue": false
  },
  "shellConnector": {
    "mode": "status_only",
    "commandExecutionExposed": false,
    "blockedStopCondition": "LOCAL_SHELL_COMMAND_EXECUTION_NOT_EXPOSED"
  },
  "localReadSurface": {
    "requiresLoopbackBindHost": true,
    "blockedStatus": 403,
    "blockedReason": "loopback host required for local dashboard data"
  }
}
