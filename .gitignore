!/.agents/codex/skills/*.yaml
!/.agents/codex/skills/*.yml
!/.agents/codex/skills/*/
!/.agents/codex/skills/*/SKILL.md

!/.agents/codex/recipes/
/.agents/codex/recipes/*
!/.agents/codex/recipes/*.csv
!/.agents/codex/recipes/*.md
!/.agents/codex/recipes/*.yaml
!/.agents/codex/recipes/*.yml

