# D:\ Cabina Universal root wrapper repo
#
# This repo is intentionally narrow. It gives Codex and Git a native root for
# the cabin while preserving every nested repo as an independent clone.

# Ignore everything by default.
/*

# Never track local/system/sensitive areas.
/.secrets/
/$RECYCLE.BIN/
/System Volume Information/
/CodexBackups/
/**/.git/
/**/.git/**
**/.env
**/.env.*
**/*secret*
**/*secreto*
**/*token*
**/*credential*
**/*password*
**/node_modules/
**/.venv/
**/__pycache__/
**/.pytest_cache/
**/.mypy_cache/

# Root governance allowlist.
!/.gitignore
!/.gitattributes
!/README.md
!/REPO_SCOPE.md
!/AGENTS.md
!/MANIFEST.yaml
!/MAPA_HUMANO.md
!/LEVELS.md
!/LEVELS.yaml
!/FOLDER_LEVELS.csv

# Control plane ingress.
!/00_CONTROL_PLANE_INGRESS/
/00_CONTROL_PLANE_INGRESS/*
!/00_CONTROL_PLANE_INGRESS/ROUTING.json

# GitHub-native agent surfaces.
!/.github/
/.github/*
!/.github/copilot-instructions.md
!/.github/PULL_REQUEST_TEMPLATE.md
!/.github/ISSUE_TEMPLATE/
/.github/ISSUE_TEMPLATE/*
!/.github/ISSUE_TEMPLATE/*.yml
!/.github/instructions/
/.github/instructions/*
!/.github/instructions/*.instructions.md
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/*.yml

# Codex app local/worktree environments for the root wrapper project.
!/.codex/
/.codex/*
!/.codex/README.md
!/.codex/environments/
/.codex/environments/*
!/.codex/environments/*.toml

# Governance registry metadata only. Repos under 10_REPOS remain ignored.
