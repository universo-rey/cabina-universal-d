!/.agents/codex/evals/
/.agents/codex/evals/*
!/.agents/codex/evals/*.csv
!/.agents/codex/evals/*.json
!/.agents/codex/evals/*.jsonl
!/.agents/codex/evals/*.md
!/.agents/codex/evals/*.py
!/.agents/codex/evals/results/
/.agents/codex/evals/results/*
!/.agents/codex/evals/results/*.json

!/.agents/codex/plugins/
